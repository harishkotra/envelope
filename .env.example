# Envelope — secrets template. Copy to .env and fill in.
# Never commit the real .env.

# --- inference: Particle.ai (OpenAI compatible) ---
PARTICLE_API_KEY=
PARTICLE_BASE_URL=https://api.particle.ai/v1
PARTICLE_MODEL=deepseek-v41-flash-1017
PARTICLE_MAX_TOKENS=2200

# --- keys ---
# OWNER signs the risk mandate. EXECUTOR is the agent key the contract authorises.
# Generate one pair with: pnpm wallet
DEPLOYER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=
EXECUTOR_ADDRESS=

# --- chain: local demo ---
NETWORK=local
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
EXPLORER_URL=http://127.0.0.1:8545

# --- chain: HSK mainnet (for the hackathon deployment gate) ---
# NETWORK=hsk
# CHAIN_ID=177
# RPC_URL=https://mainnet.hsk.xyz
# EXPLORER_URL=https://hashkey.blockscout.com
# HSK_ROUTER=0x569a9C081F8Eb11215B86723976C4b404DfF4439
# HSK_FACTORY=0x75e5da970b546e214650ae2d3b6e7918db344119
# QUOTE_TOKEN=0x054ed45810DbBAb8B27668922D110669c9D88D0a

# --- agent behaviour ---
AGENT_PORT=8788
TICK_INTERVAL_MS=90000
AUTO_START=false
# synthetic flow generator: small real swaps that make the demo pool move
NOISE_TRADER=true

# --- mandate defaults (used by the deploy scripts) ---
SEED_HSK=6
SEED_QUOTE=600000
FUND_QUOTE=300000
FUND_BASE=0.5
MAX_NOTIONAL=60000
MANDATE_DAYS=14
